    {
      "id": 8,
      "title": "Measurement coverage \u00b7 wallbox by time",
      "type": "volkovlabs-echarts-panel",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 16,
        "h": 13
      },
      "description": "Source power records per adaptive time bin: 15 minutes up to 2 days, 1 hour up to 30 days, 1 day beyond. Blank means none.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "sofie-postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "sofie-postgres"
          },
          "rawQuery": true,
          "rawSql": "SELECT date_bin(CASE WHEN $__timeTo()::timestamptz - $__timeFrom()::timestamptz > interval '30 days' THEN interval '1 day' WHEN $__timeTo()::timestamptz - $__timeFrom()::timestamptz > interval '2 days' THEN interval '1 hour' ELSE interval '15 minutes' END,ts,'2025-01-01'::timestamptz) AS bucket,wallbox_id,COUNT(*)::double precision AS avg_kw FROM charger_minute WHERE $__timeFilter(ts) GROUP BY 1,2 ORDER BY 1,2 LIMIT 8000",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "#6DD6CB"
          },
          "noValue": "No measurement",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "No measurement",
                  "color": "#8E8E8E"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "transparent": true,
      "options": {
        "renderer": "canvas",
        "map": "none",
        "editorMode": "code",
        "editor": {
          "format": "auto"
        },
        "getOption": "\nconst frame=context.panel.data.series[0];\nconst f=Object.fromEntries((frame?.fields||[]).map(x=>[x.name,x.values?.buffer||x.values||[]]));\nconst dark=context.grafana.theme.isDark;\nconst ink=dark?'#DDE9F4':'#17324A', muted=dark?'#91A4B7':'#50677C', border=dark?'#54708C':'#89A2B9';\nconst n=f.wallbox_id?.length||0;\nconst rows=Array.from({length:n},(_,i)=>({time:new Date(f.bucket[i]).getTime(),box:String(f.wallbox_id[i]),kw:Number(f.avg_kw[i])}));\nconst times=[...new Set(rows.map(r=>r.time))].sort((a,b)=>a-b);\nconst boxes=[...new Set(rows.map(r=>r.box))].sort();\nconst max=Math.max(1,...rows.map(r=>r.kw));\nconst data=rows.map(r=>[times.indexOf(r.time),boxes.indexOf(r.box),r.kw]);\nreturn {backgroundColor:'transparent',animationDuration:350,\n  grid:{left:62,right:28,top:20,bottom:68},\n  tooltip:{position:'top',backgroundColor:dark?'#142235':'#FFFFFF',borderColor:border,textStyle:{color:ink},\n    formatter:p=>`${boxes[p.data[1]]}<br/>${new Intl.DateTimeFormat('en-GB',{timeZone:'Europe/Berlin',dateStyle:'short',timeStyle:'short'}).format(new Date(times[p.data[0]]))}<br/><b>${p.data[2].toFixed(2)} minutes recorded</b>`},\n  xAxis:{type:'category',data:times.map(t=>new Intl.DateTimeFormat('en-GB',{timeZone:'Europe/Berlin',day:'2-digit',month:'short',hour:'2-digit',minute:'2-digit'}).format(new Date(t))),\n    axisLabel:{color:muted,interval:Math.max(0,Math.floor(times.length/8)-1),rotate:0},axisLine:{lineStyle:{color:border}},splitArea:{show:false}},\n  yAxis:{type:'category',data:boxes,axisLabel:{color:ink},axisLine:{lineStyle:{color:border}}},\n  visualMap:{min:0,max,calculable:false,orient:'horizontal',left:'center',bottom:0,\n    text:['HIGH','LOW'],textStyle:{color:muted},inRange:{color:['#183344','#245F70','#40B9B0','#F6BE69']}},\n  series:[{type:'heatmap',data,itemStyle:{borderColor:dark?'#142235':'#FFFFFF',borderWidth:1},emphasis:{itemStyle:{borderColor:'#FFFFFF',borderWidth:1}}}]};\n"
      }
    },
